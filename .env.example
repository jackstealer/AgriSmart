# ============================================================
# AgriSmart — Environment Variables Template
# Copy this file to .env and fill in your real values
# NEVER commit the actual .env file to git
# ============================================================

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agrismart?retryWrites=true&w=majority

# JWT secret — any long random string
JWT_SECRET_KEY=replace_with_a_long_random_secret_string

# Cloudinary — for profile image uploads
# Get from: https://cloudinary.com → Dashboard
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Razorpay — for payment processing (use test keys in dev)
# Get from: https://razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# OpenWeather — for live weather data (free tier available)
# Get from: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_32_char_openweather_api_key

# Groq AI — for chatbot (free tier, keys start with gsk_)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini — for disease detection vision AI (free tier)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace — optional, for additional ML models
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your_token_here

# ML Server URL (Flask service — run locally or on a server)
ML_SERVER_URL=http://localhost:5001

# Server Port
PORT=5000

# CORS allowed origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
