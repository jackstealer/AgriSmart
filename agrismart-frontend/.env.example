# Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# Backend API URL (must match the backend PORT in backend/.env)
VITE_API_URL=http://localhost:5000

# OpenWeather API Key (used for geocoding fallback if needed client-side)
# Get from: https://home.openweathermap.org/api_keys
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Razorpay Key ID (public key — safe to expose on client)
# Get from: https://razorpay.com → Settings → API Keys (use test key in dev)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# NOTE: RAZORPAY_KEY_SECRET must NEVER be set here — keep it in backend/.env only
